[Unit]
Description=Inky Image Viewer
Wants=network-online.target
After=network-online.target
# A permanent startup failure (for example port 80 already taken) must surface as
# a failed unit instead of an endless 10 second restart loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__INKY_USER__
WorkingDirectory=__INKY_TARGET_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=INKY_IMAGE_CONFIG_PATH=__INKY_HOME__/.config/inky-image/config.json
Environment=INKY_IMAGE_BROWSE_ROOTS=__INKY_HOME__:/mnt:/media
ExecStart=__INKY_TARGET_DIR__/venv/bin/python -m inky_image.main
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=false
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
